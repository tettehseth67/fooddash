{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data including preferences and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "isDriver": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "favorites": { "type": "array", "items": { "type": "string" } },
        "phone": { "type": "string" },
        "addresses": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Restaurant information and details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "rating": { "type": "number" },
        "deliveryTime": { "type": "string" },
        "deliveryFee": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["name", "description", "category"]
    },
    "MenuItem": {
      "title": "Menu Item",
      "description": "Individual dish or item in a restaurant's menu",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "isVegetarian": { "type": "boolean" },
        "isSpicy": { "type": "boolean" }
      },
      "required": ["restaurantId", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Food delivery order data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "restaurantId": { "type": "string" },
        "driverId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "assigned", "delivering", "completed", "cancelled"] },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "restaurantName": { "type": "string" },
        "restaurantAddress": { "type": "string" },
        "restaurantLat": { "type": "number" },
        "restaurantLng": { "type": "number" },
        "deliveryOption": { "type": "string" },
        "instructions": { "type": "string" },
        "isRated": { "type": "boolean" }
      },
      "required": ["userId", "restaurantId", "items", "total", "status", "createdAt"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Delivery driver profile and status",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "rating": { "type": "number" },
        "phone": { "type": "string" },
        "isOnline": { "type": "boolean" }
      },
      "required": ["name"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer review for restaurant or driver",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "restaurantId": { "type": "string" },
        "driverId": { "type": "string" },
        "rating": { "type": "number" },
        "driverRating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "restaurantId", "rating", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Message in order-related chat",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["orderId", "senderId", "text", "createdAt"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Marketing promotion or banner",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "imageUrl": { "type": "string" },
        "link": { "type": "string" },
        "active": { "type": "boolean" },
        "color": { "type": "string" }
      },
      "required": ["title", "imageUrl", "active"]
    }
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "restaurants": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Restaurant data"
    },
    "menu": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu items for all restaurants"
    },
    "orders": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Food orders"
    },
    "drivers": {
      "schema": { "$ref": "#/entities/Driver" },
      "description": "Driver profiles"
    },
    "reviews": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews"
    },
    "messages": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Order chat messages"
    },
    "promotions": {
      "schema": { "$ref": "#/entities/Promotion" },
      "description": "Active promotions"
    },
    "admins": {
      "schema": { "type": "object", "properties": { "active": { "type": "boolean" } } },
      "description": "Admin lookups"
    }
  }
}
