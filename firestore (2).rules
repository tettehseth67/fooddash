rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'tettehseth67@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('isAdmin' in data) || data.isAdmin is bool)
        && (!('isDriver' in data) || data.isDriver is bool);
    }

    function isValidRestaurant(data) {
      return data.keys().hasAll(['name', 'description', 'category'])
        && data.name is string && data.name.size() <= 100
        && data.description is string && data.description.size() <= 1000
        && data.category is string && data.category.size() <= 50;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'restaurantId', 'items', 'total', 'status', 'createdAt'])
        && data.userId == request.auth.uid
        && data.status in ['pending', 'preparing', 'assigned', 'delivering', 'completed', 'cancelled']
        && data.total is number && data.total >= 0
        && data.items is list && data.items.size() > 0
        && data.createdAt == request.time;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'restaurantId', 'rating', 'createdAt'])
        && data.userId == request.auth.uid
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['orderId', 'senderId', 'text', 'createdAt'])
        && data.senderId == request.auth.uid
        && data.text is string && data.text.size() <= 2000
        && data.createdAt == request.time;
    }

    // -------------------------------------------------------------------------
    // MATCH BLOCKS
    // -------------------------------------------------------------------------

    // Test connection path (allowed for health check)
    match /test/connection {
      allow read: if true;
    }

    // Default deny (fallback)
    match /{document=**} {
      allow read, write: if false;
    }

    // ADMNS
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable through Firebase Console or Admin SDK
    }

    // USERS
    match /users/{userId} {
      allow create: if isOwner(userId) && isValidUser(incoming()) 
                     && (!('isAdmin' in incoming()) || incoming().isAdmin == false); // Can't self-promote
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow update: if (isOwner(userId) || isAdmin()) 
                    && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'favorites', 'phone', 'addresses', 'updatedAt', 'isOnline']))
                    && (isAdmin() || !('isAdmin' in incoming()));
    }

    // RESTAURANTS
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // MENU
    match /menu/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(incoming().restaurantId);
      allow update, delete: if isAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      function canSeeOrder() {
        return isOwner(existing().userId) 
          || (isSignedIn() && existing().driverId == request.auth.uid)
          || isAdmin();
      }

      allow create: if isSignedIn() && isValidOrder(incoming()) && exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId));
      allow get: if canSeeOrder();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        // User cancelling their own pending order
        (isOwner(existing().userId) && existing().status == 'pending' && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Driver picking up order
        (existing().status in ['pending', 'preparing'] && !('driverId' in existing()) && incoming().driverId == request.auth.uid && incoming().status == 'assigned' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverId', 'updatedAt'])) ||
        // Driver status updates
        (existing().driverId == request.auth.uid && incoming().status in ['preparing', 'assigned', 'delivering', 'completed'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // DRIVERS
    match /drivers/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && incoming().keys().hasAll(['name']) && (!('isAdmin' in incoming()));
      allow update: if isOwner(userId) || isAdmin();
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update, delete: if isAdmin();
    }

    // MESSAGES
    match /messages/{messageId} {
      function canChat() {
        let order = get(/databases/$(database)/documents/orders/$(incoming().orderId)).data;
        return order.userId == request.auth.uid || order.driverId == request.auth.uid || isAdmin();
      }
      
      function canReadChat(orderId) {
        let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
        return order.userId == request.auth.uid || order.driverId == request.auth.uid || isAdmin();
      }

      allow create: if isSignedIn() && isValidMessage(incoming()) && canChat();
      allow list: if isSignedIn() && canReadChat(request.query.limit(1).orderId); // Simplified for queries
      // Standard messages are usually read via filtered queries
      allow get: if isSignedIn() && canReadChat(existing().orderId);
    }

    // PROMOTIONS
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
